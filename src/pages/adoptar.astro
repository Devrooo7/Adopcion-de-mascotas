---
// src/pages/adoptar.astro
import '../styles/global.css';

const mascotas = [
  { id: 'indeciso', nombre: 'Aún no lo decido / Ver opciones' },
  { id: 'toby', nombre: 'Toby (Perro)' },
  { id: 'luna', nombre: 'Luna (Gato)' },
  { id: 'rocky', nombre: 'Rocky (Perro)' },
  { id: 'mimi', nombre: 'Mimi (Gato)' },
  { id: 'buba', nombre: 'Buba (Perro)' },
  { id: 'simba', nombre: 'Simba (Gato)' },
  { id: 'max', nombre: 'Max (Perro)' },
  { id: 'garfield', nombre: 'Garfield (Gato)' },
  { id: 'kira', nombre: 'Kira (Perro)' },
  { id: 'pelusa', nombre: 'Pelusa (Gato)' },
  { id: 'bruno', nombre: 'Bruno (Perro)' },
  { id: 'salem', nombre: 'Salem (Gato)' }
];
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitud de Adopción Profesional - Huellitas en Casa</title>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col">

    <!-- NAVEGACIÓN -->
    <nav class="bg-white border-b border-amber-100 sticky top-0 z-50 shadow-xs">
        <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
            <a href="/" class="text-slate-500 hover:text-amber-600 font-medium flex items-center gap-2 transition-colors">
                ← Volver a mascotas
            </a>
            <span class="text-sm font-bold text-amber-600">Huellitas en Casa 🐾</span>
        </div>
    </nav>

    <!-- FORMULARIO PRINCIPAL -->
    <main class="flex-grow flex justify-center p-4 py-10 md:py-16">
        <div class="max-w-3xl w-full">
            <div class="mb-8 text-center">
                <h1 class="text-3xl md:text-5xl font-black text-slate-900 mb-4 tracking-tight">Formulario de Adopción</h1>
                <p class="text-slate-500 max-w-xl mx-auto">Queremos asegurarnos de que nuestras mascotas vayan al mejor hogar posible. Por favor, tómate tu tiempo para llenar este formulario con sinceridad.</p>
            </div>
            
            <form id="form-adopcion" class="space-y-8">
                
                <!-- SECCIÓN 1: DATOS PERSONALES -->
                <section class="bg-white p-8 rounded-3xl shadow-md border border-slate-100">
                    <h2 class="text-xl font-bold text-amber-600 mb-6 flex items-center gap-2">
                        <span class="bg-amber-100 text-amber-800 w-8 h-8 rounded-full flex items-center justify-center text-sm">1</span> 
                        Datos del Adoptante
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="md:col-span-2 field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Nombre Completo <span class="asterisco">*</span></label>
                            <input type="text" name="nombre" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white transition-all" placeholder="Ej. Juan Pérez García">
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Edad <span class="asterisco">*</span></label>
                            <input type="number" name="edad" min="18" max="99" oninput="if(this.value.length > 2) this.value = this.value.slice(0, 2);" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white transition-all" placeholder="Debes ser mayor de 18 años">
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Ocupación / Empleo <span class="asterisco">*</span></label>
                            <input type="text" name="ocupacion" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white transition-all" placeholder="Ej. Arquitecto, Estudiante, etc.">
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Teléfono / WhatsApp <span class="asterisco">*</span></label>
                            <input type="tel" name="telefono" maxlength="10" pattern="[0-9]{10}" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white transition-all" placeholder="10 dígitos numéricos">
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Correo Electrónico <span class="asterisco">*</span></label>
                            <input type="email" name="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white transition-all" placeholder="tu@correo.com">
                        </div>
                    </div>
                </section>

                <!-- SECCIÓN 2: SOBRE EL HOGAR -->
                <section class="bg-white p-8 rounded-3xl shadow-md border border-slate-100">
                    <h2 class="text-xl font-bold text-amber-600 mb-6 flex items-center gap-2">
                        <span class="bg-amber-100 text-amber-800 w-8 h-8 rounded-full flex items-center justify-center text-sm">2</span> 
                        Sobre tu Estilo de Vida
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Tipo de vivienda <span class="asterisco">*</span></label>
                            <select name="tipo_vivienda" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white cursor-pointer">
                                <option value="" disabled selected>Selecciona una opción</option>
                                <option value="casa">Casa con patio</option>
                                <option value="departamento">Departamento</option>
                                <option value="terreno">Finca / Rancho</option>
                            </select>
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">La vivienda es... <span class="asterisco">*</span></label>
                            <select name="propiedad_vivienda" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white cursor-pointer">
                                <option value="" disabled selected>Selecciona una opción</option>
                                <option value="propia">Propia</option>
                                <option value="rentada">Rentada (Mi casero permite mascotas)</option>
                                <option value="rentada_no_sabe">Rentada (No estoy seguro si permiten mascotas)</option>
                            </select>
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">¿Viven niños en la casa? <span class="asterisco">*</span></label>
                            <select name="ninos_en_casa" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white cursor-pointer">
                                <option value="no">No</option>
                                <option value="si_pequenos">Sí, menores de 5 años</option>
                                <option value="si_grandes">Sí, mayores de 5 años</option>
                            </select>
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">¿Tienes otras mascotas? <span class="asterisco">*</span></label>
                            <select name="personas_en_casa" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white cursor-pointer">
                                <option value="no">No, sería la única</option>
                                <option value="si_perros">Sí, tengo perro(s)</option>
                                <option value="si_gatos">Sí, tengo gato(s)</option>
                                <option value="si_ambos">Sí, tengo perros y gatos</option>
                            </select>
                        </div>

                        <div class="md:col-span-2 field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">¿Cuántas horas pasará la mascota sola al día? <span class="asterisco">*</span></label>
                            <input type="text" name="horas_sola" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white transition-all" placeholder="Ej. Unas 4 horas en la mañana por el trabajo">
                        </div>
                    </div>
                </section>

                <!-- SECCIÓN 3: LA ADOPCIÓN -->
                <section class="bg-white p-8 rounded-3xl shadow-md border border-slate-100">
                    <h2 class="text-xl font-bold text-amber-600 mb-6 flex items-center gap-2">
                        <span class="bg-amber-100 text-amber-800 w-8 h-8 rounded-full flex items-center justify-center text-sm">3</span> 
                        Sobre la Adopción
                    </h2>
                    
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Mascota de interés</label>
                            <select id="mascota-select" name="mascota" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-amber-50 font-medium cursor-pointer">
                                {mascotas.map(m => (
                                    <option value={m.id}>{m.nombre}</option>
                                ))}
                            </select>
                        </div>

                        <div class="field-group">
                            <label class="block text-sm font-bold text-slate-700 mb-2">¿Por qué deseas adoptar una mascota? <span class="asterisco">*</span></label>
                            <textarea name="motivo_adopcion" required rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none bg-slate-50 focus:bg-white transition-all resize-none" placeholder="Cuéntanos un poco sobre tus motivos..."></textarea>
                        </div>

                        <!-- CHECKBOXES DE COMPROMISO -->
                        <div class="space-y-3 mt-6 bg-slate-50 p-6 rounded-2xl border border-slate-200">
                            <h4 class="font-bold text-slate-800 mb-4 text-sm uppercase tracking-wide">Términos de adopción</h4>
                            
                            <label class="flex items-start gap-3 cursor-pointer group">
                                <input type="checkbox" name="acuerdo_gastos" required class="mt-1 w-5 h-5 text-amber-500 rounded border-slate-300 focus:ring-amber-400">
                                <span class="text-sm text-slate-600 group-hover:text-slate-900 transition-colors">Estoy consciente de los gastos que implica una mascota (alimentación de calidad, vacunas, veterinario) y puedo solventarlos.</span>
                            </label>
                            
                            <label class="flex items-start gap-3 cursor-pointer group">
                                <input type="checkbox" name="acuerdo_visitas" required class="mt-1 w-5 h-5 text-amber-500 rounded border-slate-300 focus:ring-amber-400">
                                <span class="text-sm text-slate-600 group-hover:text-slate-900 transition-colors">Estoy de acuerdo en recibir una llamada o visita de seguimiento para comprobar que la mascota se ha adaptado bien a su nuevo hogar.</span>
                            </label>
                        </div>
                    </div>
                </section>

                <div class="pt-4 pb-8">
                    <button id="btn-submit" type="submit" class="w-full bg-slate-900 hover:bg-amber-500 text-white font-black text-xl py-5 rounded-2xl transition-all duration-300 shadow-xl hover:shadow-2xl cursor-pointer active:scale-[0.98] flex items-center justify-center gap-2">
                        Enviar mi Solicitud Formal 🐾
                    </button>
                    <p class="text-center text-xs text-slate-400 mt-4">Tus datos están seguros con nosotros. Solo los usaremos para el proceso de adopción.</p>
                </div>
            </form>
        </div>
    </main>

    <!-- FOOTER SIMPLE -->
    <footer class="bg-slate-900 text-slate-400 text-center py-6 text-sm border-t-4 border-amber-500">
        &copy; {new Date().getFullYear()} Huellitas en Casa. Por un mundo con menos abandono.
    </footer>

    <!-- SCRIPT DE ENVÍO Y AUTOSELECCIÓN -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const mascotaId = urlParams.get('mascota');
            
            if (mascotaId) {
                const select = document.getElementById('mascota-select') as HTMLSelectElement;
                if (select) {
                    select.value = mascotaId;
                }
            }

            const form = document.getElementById('form-adopcion') as HTMLFormElement;
            const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

            if (form) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    form.classList.add('submitted');

                    if (!form.checkValidity()) {
                        return;
                    }

                    if (btnSubmit) {
                        btnSubmit.disabled = true;
                        btnSubmit.textContent = 'Enviando solicitud... 🐾';
                    }

                    const formData = new FormData(form);

                    try {
                        const response = await fetch('/api/adopcion', {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            window.location.href = '/gracias/';
                        } else {
                            const errorData = await response.json().catch(() => ({}));
                            alert('Error al enviar la solicitud: ' + (errorData.error || 'Inténtalo de nuevo.'));
                            if (btnSubmit) {
                                btnSubmit.disabled = false;
                                btnSubmit.textContent = 'Enviar mi Solicitud Formal 🐾';
                            }
                        }
                    } catch (error) {
                        console.error(error);
                        alert('Ocurrió un problema de conexión al enviar el formulario.');
                        if (btnSubmit) {
                            btnSubmit.disabled = false;
                            btnSubmit.textContent = 'Enviar mi Solicitud Formal 🐾';
                        }
                    }
                });
            }
        });
    </script>

    <style>
        .asterisco {
            color: #64748b;
            transition: color 0.2s ease;
        }

        form.submitted .field-group:has(input:invalid) .asterisco,
        form.submitted .field-group:has(select:invalid) .asterisco,
        form.submitted .field-group:has(textarea:invalid) .asterisco {
            color: #ef4444 !important;
            font-weight: bold;
        }
    </style>
</body>
</html>