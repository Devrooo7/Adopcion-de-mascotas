---
// src/pages/admin/solicitudes.astro
import '../../styles/global.css';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { cookies, redirect, url } = Astro;
const accessToken = cookies.get('sb-access-token');
const refreshToken = cookies.get('sb-refresh-token');

if (!accessToken || !refreshToken) {
  return redirect('/admin/login');
}

const { data: sessionData, error: sessionError } = await supabase.auth.setSession({
  access_token: accessToken.value,
  refresh_token: refreshToken.value,
});

if (sessionError || !sessionData.session) {
  return redirect('/admin/login');
}

// Obtener filtro desde la URL (?filtro=nuevo, etc.)
const filtroActual = url.searchParams.get('filtro') || 'todos';

// Cargar solicitudes desde Supabase
let query = supabase.from('solicitudes').select('*').order('created_at', { ascending: false });

if (filtroActual !== 'todos') {
  query = query.eq('estado', filtroActual);
}

const { data: solicitudesDB, error } = await query;
const solicitudes = solicitudesDB || [];
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Solicitudes - Admin Huellitas</title>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col">

    <!-- BARRA DE NAVEGACIÓN ADMINISTRATIVA -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-6">
                <span class="font-black text-xl text-amber-400">🐾 Admin Huellitas</span>
                <nav class="hidden md:flex gap-4 text-sm font-bold">
                    <a href="/admin/solicitudes" class="text-amber-400 bg-slate-800 px-3 py-1.5 rounded-lg">Solicitudes 📋</a>
                    <a href="/admin/mascotas" class="text-slate-300 hover:text-white px-3 py-1.5 rounded-lg transition-colors">CRUD de Mascotas 🐶🐱</a>
                </nav>
            </div>
            <div class="flex items-center gap-4">
                <a href="/" target="_blank" class="text-xs text-slate-400 hover:text-white transition-colors">Ver Sitio Público ↗</a>
                <form action="/api/admin/logout" method="POST">
                    <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-3 py-2 rounded-xl transition-colors cursor-pointer">
                        Cerrar Sesión
                    </button>
                </form>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-black text-slate-900">Solicitudes de Adopción</h1>
                <p class="text-sm text-slate-500">Revisa y administra las solicitudes de los usuarios interesados.</p>
            </div>
        </div>

        <!-- FILTROS SUPERIORES POR ESTATUS -->
        <div class="flex flex-wrap gap-2 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm items-center">
            <span class="text-xs font-bold text-slate-500 mr-2 uppercase tracking-wider">Filtrar por:</span>
            <a href="/admin/solicitudes" class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${filtroActual === 'todos' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>Todos</a>
            <a href="/admin/solicitudes?filtro=nuevo" class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${filtroActual === 'nuevo' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>Nuevos 🆕</a>
            <a href="/admin/solicitudes?filtro=aceptada" class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${filtroActual === 'aceptada' ? 'bg-emerald-600 text-white' : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100'}`}>Aceptadas ✅</a>
            <a href="/admin/solicitudes?filtro=revision" class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${filtroActual === 'revision' ? 'bg-amber-500 text-white' : 'bg-amber-50 text-amber-700 hover:bg-amber-100'}`}>En Revisión 🔍</a>
            <a href="/admin/solicitudes?filtro=pendiente" class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${filtroActual === 'pendiente' ? 'bg-blue-600 text-white' : 'bg-blue-50 text-blue-700 hover:bg-blue-100'}`}>Pendientes ⏳</a>
            <a href="/admin/solicitudes?filtro=descartado" class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${filtroActual === 'descartado' ? 'bg-rose-600 text-white' : 'bg-rose-50 text-rose-700 hover:bg-rose-100'}`}>Descartados ❌</a>
        </div>

        {error && (
            <div class="bg-rose-50 border border-rose-200 text-rose-700 p-4 rounded-2xl text-xs font-bold">
                Error al cargar solicitudes: {error.message}
            </div>
        )}

        <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-100/70 border-b border-slate-200 text-slate-600 text-xs font-black uppercase tracking-wider">
                            <th class="p-4">Solicitante</th>
                            <th class="p-4">Mascota de Interés</th>
                            <th class="p-4">Contacto</th>
                            <th class="p-4">Vivienda / Experiencia</th>
                            <th class="p-4">Estatus</th>
                            <th class="p-4 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        {solicitudes.length > 0 ? (
                            solicitudes.map((sol) => (
                                <tr class="hover:bg-amber-50/30 transition-colors">
                                    <td class="p-4 align-top">
                                        <p class="font-black text-slate-900">{sol.nombre_adoptante}</p>
                                        <p class="text-xs text-slate-500">Edad: {sol.edad} años</p>
                                        <p class="text-xs text-slate-500">{sol.ocupacion}</p>
                                    </td>
                                    <td class="p-4 align-top font-bold text-amber-600">
                                        {sol.mascota_id ? `ID: ${sol.mascota_id}` : 'General / No especificada'}
                                    </td>
                                    <td class="p-4 align-top text-xs space-y-1">
                                        <p class="font-mono text-slate-700">📧 {sol.email}</p>
                                        <p class="font-mono text-slate-700">📱 {sol.telefono}</p>
                                    </td>
                                    <td class="p-4 align-top text-xs space-y-1 max-w-xs">
                                        <p>🏡 Casa: <span class="font-bold">{sol.tipo_vivienda}</span> ({sol.propiedad_vivienda})</p>
                                        <p>👶 Niños: {sol.ninos_en_casa}</p>
                                        <p>🐾 Otras mascotas: {sol.otras_mascotas}</p>
                                        <p>⏰ Horas sola: {sol.horas_sola}</p>
                                        <p class="text-slate-500 truncate" title={sol.motivo_adopcion}>Razones: {sol.motivo_adopcion}</p>
                                    </td>
                                    <td class="p-4 align-top">
                                        <!-- CAMBIO DE ESTATUS CON SINCRONIZACIÓN AUTOMÁTICA DE MASCOTA -->
                                        <select 
                                            data-solicitud-id={sol.id}
                                            data-mascota-id={sol.mascota_id}
                                            class="cambiar-estatus-select text-xs font-extrabold px-3 py-1.5 rounded-xl border cursor-pointer transition-colors bg-slate-100 text-slate-700 border-slate-300"
                                        >
                                            <option value="nuevo" selected={sol.estado === 'nuevo'}>Nuevo 🆕</option>
                                            <option value="aceptada" selected={sol.estado === 'aceptada'}>Aceptada ✅</option>
                                            <option value="revision" selected={sol.estado === 'revision'}>En Revisión 🔍</option>
                                            <option value="pendiente" selected={sol.estado === 'pendiente'}>Pendiente ⏳</option>
                                            <option value="descartado" selected={sol.estado === 'descartado'}>Descartado ❌</option>
                                        </select>
                                    </td>
                                    <td class="p-4 align-top text-center">
                                        <div class="flex flex-col items-center justify-center gap-1.5">
                                            <button 
                                                data-email={sol.email}
                                                class="btn-contactar bg-slate-900 hover:bg-amber-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-colors shadow-sm cursor-pointer"
                                            >
                                                Copiar Correo 📋
                                            </button>
                                            <a 
                                                href={`https://mail.google.com/mail/?view=cm&fs=1&to=${sol.email}&su=Proceso%20de%20adopci%C3%B3n%20-%20Huellitas%20en%20Casa`} 
                                                target="_blank"
                                                class="text-[11px] font-bold text-amber-600 hover:underline"
                                            >
                                                Abrir en Gmail ↗
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            ))
                        ) : (
                            <tr>
                                <td colspan="6" class="p-12 text-center text-slate-400 font-medium">
                                    No hay solicitudes de adopción con este filtro en este momento.
                                </td>
                            </tr>
                        )}
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- SCRIPT DE INTERACCIÓN CLIENTE (ACTUALIZAR ESTATUS DE SOLICITUD Y MASCOTA) -->
    <script>
        import { supabase } from '../../lib/supabase';

        // Manejar cambio de estatus en tiempo real
        document.querySelectorAll('.cambiar-estatus-select').forEach(select => {
            select.addEventListener('change', async (e) => {
                const target = e.target as HTMLSelectElement;
                const id = target.getAttribute('data-solicitud-id');
                const mascotaId = target.getAttribute('data-mascota-id');
                const nuevoEstado = target.value;

                target.disabled = true;

                // 1. Actualizar el estado de la solicitud en Supabase
                const { error: errorSolicitud } = await supabase
                    .from('solicitudes')
                    .update({ estado: nuevoEstado })
                    .eq('id', id);

                if (errorSolicitud) {
                    alert('Error al actualizar la solicitud: ' + errorSolicitud.message);
                    target.disabled = false;
                    return;
                }

                // 2. Si hay una mascota asociada, actualizar su estado en la tabla 'mascotas'
                if (mascotaId && mascotaId !== 'null' && mascotaId.trim() !== '') {
                    const estadoMascota = nuevoEstado === 'aceptada' ? 'adoptado' : 'disponible';
                    
                    // Actualiza buscando por id coincidente o por nombre de la mascota
                    const { error: errorMascota } = await supabase
                        .from('mascotas')
                        .update({ estado: estadoMascota })
                        .or(`id.eq.${mascotaId},nombre.ilike.${mascotaId}`);

                    if (errorMascota) {
                        console.error('Error actualizando estado de la mascota:', errorMascota);
                    }
                }

                target.disabled = false;
                window.location.reload();
            });
        });

        // Manejar botón de copiar correo al portapapeles
        document.querySelectorAll('.btn-contactar').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                const email = target.getAttribute('data-email');

                if (email) {
                    navigator.clipboard.writeText(email);
                    const textoOriginal = target.innerText;
                    target.innerText = '¡Copiado! ✅';
                    target.classList.replace('bg-slate-900', 'bg-emerald-600');

                    setTimeout(() => {
                        target.innerText = textoOriginal;
                        target.classList.replace('bg-emerald-600', 'bg-slate-900');
                    }, 2000);
                }
            });
        });
    </script>
</body>
</html>